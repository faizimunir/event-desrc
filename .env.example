APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting — Pusher cloud (termudah): isi dari dashboard Pusher, BROADCAST_CONNECTION=pusher, cluster (mis. ap1).
# Biarkan PUSHER_HOST kosong agar memakai endpoint resmi cluster (api-<cluster>.pusher.com).
# Soketi / host sendiri: isi PUSHER_HOST + port + scheme; APP_ID/KEY/SECRET sama dengan server Soketi. Lihat blok di bawah VITE_*.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# --- Contoh Soketi (WebSocket host sendiri, kompatibel Pusher) ---
# 1) Di .env aktif, samakan kredensial dengan yang Anda set saat menjalankan Soketi:
#    PUSHER_APP_ID=local
#    PUSHER_APP_KEY=local
#    PUSHER_APP_SECRET=local
#    PUSHER_APP_CLUSTER=mt1
#    PUSHER_HOST=127.0.0.1
#    PUSHER_PORT=6001
#    PUSHER_SCHEME=http
#    BROADCAST_CONNECTION=pusher
# 2) Jalankan Soketi (terminal terpisah):
#    Windows + Node 20/22: CLI Soketi sering gagal (uWebSockets hanya dukung Node 14/16/18 di Windows).
#    Solusi: pakai Docker di bawah, ATAU nvm/fnm untuk Node 18 lalu `npm i -g @soketi/soketi` + `soketi start`.
#    Docker (disarankan di Windows):
#    docker run -p 6001:6001 -e SOKETI_DEBUG=1 -e SOKETI_DEFAULT_APP_ID=local -e SOKETI_DEFAULT_APP_KEY=local -e SOKETI_DEFAULT_APP_SECRET=local quay.io/soketi/soketi:latest
# 3) php artisan config:clear lalu buka ulang halaman Drag Race Timer.
# Catatan: HP/tablet di WiFi lain harus bisa ke host:6001 (bukan localhost); pakai IP LAN server di PUSHER_HOST + firewall buka port.

# Whacenter (WhatsApp OTP untuk aktivasi akun)
WHACENTER_DEVICE_ID=
WHACENTER_BASE_URL=https://app.whacenter.com
# Antrian untuk kirim WA (pastikan `php artisan queue:work` jalan; lihat QUEUE_CONNECTION)
WHACENTER_QUEUE=default
# Jeda acak antar job sebelum kirim (detik), mengurangi burst ke API
WHACENTER_DELAY_MIN_SECONDS=5
WHACENTER_DELAY_MAX_SECONDS=30

# Moota (webhook mutasi bank — set URL ke https://your-domain/webhooks/moota)
MOOTA_WEBHOOK_SECRET=
# settle = Moota menyelesaikan pembayaran (default). record_only = hanya arsip mutasi (Winpay/gateway lain yang settle)
# MOOTA_WEBHOOK_MODE=record_only
# Optional: harus sama dengan header dari Moota jika dikonfigurasi di dashboard
# MOOTA_WEBHOOK_USER=
# MOOTA_WEBHOOK_TOKEN=
# Optional: batasi mutasi ke nomor rekening tertentu (tanpa spasi)
# MOOTA_EXPECTED_ACCOUNT_NUMBER=
# Rekening yang dipantau (instruksi di halaman bayar); default mengikuti PAYMENT_MANUAL_*
# MOOTA_BANK_NAME=
# MOOTA_ACCOUNT_NUMBER=
# MOOTA_ACCOUNT_HOLDER=

# Winpay SNAP — QRIS dinamis (opsional; set WINPAY_ENABLED=true + kredensial dari Winpay)
# WINPAY_ENABLED=false
# WINPAY_BASE_URL=https://sandbox-api.bmstaging.id/snap
# WINPAY_PARTNER_ID=
# WINPAY_CHANNEL_ID=WEB
# Path ke file PEM private key merchant — relatif ke root project (atau path absolut)
# Contoh setelah `openssl genrsa`: storage/app/winpay/merchant-private.pem
# WINPAY_PRIVATE_KEY_PATH=storage/app/winpay/merchant-private.pem
# WINPAY_PRIVATE_KEY=
# WINPAY_TERMINAL_ID=
