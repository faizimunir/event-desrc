APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Whacenter (WhatsApp OTP untuk aktivasi akun)
WHACENTER_DEVICE_ID=
WHACENTER_BASE_URL=https://app.whacenter.com
# Antrian untuk kirim WA (pastikan `php artisan queue:work` jalan; lihat QUEUE_CONNECTION)
WHACENTER_QUEUE=default
# Jeda acak antar job sebelum kirim (detik), mengurangi burst ke API
WHACENTER_DELAY_MIN_SECONDS=5
WHACENTER_DELAY_MAX_SECONDS=30

# Moota: sama inti Herd/deltae — `config/services.php` key `moota`
# URL webhook: https://domain/api/webhooks/moota
# Secret harus sama dengan saat buat webhook di dashboard Moota
MOOTA_WEBHOOK_SECRET=
# Queue proses webhook QRIS statis (paksa ke Redis biar response webhook cepat)
MOOTA_QUEUE_CONNECTION=redis
MOOTA_QUEUE=moota
# Gambar QRIS statis (opsional, untuk tampilan halaman bayar)
# MOOTA_QRIS_IMAGE_URL=
# Jika hanya memakai fallback legacy: MOOTA_STATIC_QRIS_IMAGE_URL
# Rekening yang ditampilkan (opsional, default: PAYMENT_MANUAL_*)
# MOOTA_BANK_NAME=
# MOOTA_ACCOUNT_NUMBER=
# MOOTA_ACCOUNT_HOLDER=
