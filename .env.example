APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting — Pusher cloud (termudah): isi dari dashboard Pusher, BROADCAST_CONNECTION=pusher, cluster (mis. ap1).
# Biarkan PUSHER_HOST kosong agar memakai endpoint resmi cluster (api-<cluster>.pusher.com).
# Soketi / host sendiri: isi PUSHER_HOST + port + scheme; APP_ID/KEY/SECRET sama dengan server Soketi. Lihat blok di bawah VITE_*.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# --- Contoh Soketi (WebSocket host sendiri, kompatibel Pusher) ---
# 1) Di .env aktif, samakan kredensial dengan yang Anda set saat menjalankan Soketi:
#    PUSHER_APP_ID=local
#    PUSHER_APP_KEY=local
#    PUSHER_APP_SECRET=local
#    PUSHER_APP_CLUSTER=mt1
#    PUSHER_HOST=127.0.0.1
#    PUSHER_PORT=6001
#    PUSHER_SCHEME=http
#    BROADCAST_CONNECTION=pusher
# 2) Jalankan Soketi (terminal terpisah):
#    Windows + Node 20/22: CLI Soketi sering gagal (uWebSockets hanya dukung Node 14/16/18 di Windows).
#    Solusi: pakai Docker di bawah, ATAU nvm/fnm untuk Node 18 lalu `npm i -g @soketi/soketi` + `soketi start`.
#    Docker (disarankan di Windows):
#    docker run -p 6001:6001 -e SOKETI_DEBUG=1 -e SOKETI_DEFAULT_APP_ID=local -e SOKETI_DEFAULT_APP_KEY=local -e SOKETI_DEFAULT_APP_SECRET=local quay.io/soketi/soketi:latest
# 3) php artisan config:clear lalu buka ulang halaman Drag Race Timer.
# Catatan: HP/tablet di WiFi lain harus bisa ke host:6001 (bukan localhost); pakai IP LAN server di PUSHER_HOST + firewall buka port.

# Whacenter (WhatsApp OTP untuk aktivasi akun)
WHACENTER_DEVICE_ID=
WHACENTER_BASE_URL=https://app.whacenter.com
# Antrian khusus WA — jalankan: php artisan queue:work redis --queue=whatsapp
WHACENTER_QUEUE_CONNECTION=redis
WHACENTER_QUEUE=whatsapp
# Jeda acak serial sebelum tiap pesan (detik), termasuk pesan pertama
WHACENTER_DELAY_MIN_SECONDS=30
WHACENTER_DELAY_MAX_SECONDS=300

# Moota: sama inti Herd/deltae — `config/services.php` key `moota`
# URL webhook: https://domain/api/webhooks/moota
# Secret harus sama dengan saat buat webhook di dashboard Moota
MOOTA_WEBHOOK_SECRET=
# Queue proses webhook QRIS statis (paksa ke Redis biar response webhook cepat)
MOOTA_QUEUE_CONNECTION=redis
MOOTA_QUEUE=moota
# Gambar QRIS statis (opsional, untuk tampilan halaman bayar)
# MOOTA_QRIS_IMAGE_URL=
# Jika hanya memakai fallback legacy: MOOTA_STATIC_QRIS_IMAGE_URL
# Rekening yang ditampilkan (opsional, default: PAYMENT_MANUAL_*)
# MOOTA_BANK_NAME=
# MOOTA_ACCOUNT_NUMBER=
# MOOTA_ACCOUNT_HOLDER=
